# Copy this file to backend/.env and fill in what you have. backend/.env is never committed.
# Leave a key empty to switch that provider off. No quotes needed.

# Which provider drafts text: gemini | meta | (empty = model features off)
NEUROTWIN_AI_PROVIDER=

# Google Gemini API
GEMINI_API_KEY=
# A model id from `python scripts/list_models.py`, for example the name after "models/"
GEMINI_MODEL=

# Meta Model API (OpenAI-style)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# A model id from `python scripts/list_models.py`
META_MODEL=

# Most model calls allowed per day across all visitors (each draft uses 1 or 2). Protects your quota on a public demo.
NEUROTWIN_AI_DAILY_CALLS=200

# Only synthetic demo data may be sent to these providers. Real health data needs a provider and region
# approved for it first (docs/STATUS.md).

# Voice typing (speech to text) always uses Gemini, with GEMINI_MODEL above.
NEUROTWIN_STT_DAILY_CALLS=100
