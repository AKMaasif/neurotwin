# Copy to .env. Never put keys in frontend JavaScript or commit this file with values.
APP_ENV=development
DATABASE_URL=sqlite:///./data/neurotwin.db
SEED_DEMO=true
# Generate a local password with: uv run python -m app.bootstrap
DEMO_PASSWORD=
GEMINI_API_KEY=
META_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
META_BASE_URL=https://api.meta.ai/v1
AI_ENABLED=false
GEMINI_ROUTINE_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-pro
META_DRAFT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
AI_TIMEOUT_SECONDS=25
AI_MAX_CALLS_PER_MINUTE=12

# Optional path to a separately installed LibreOffice headless executable for .doc conversion.
DOCUMENT_SOFFICE=

# Private messaging objects are outside both public static roots.
# MEDIA_STORE_PATH=D:/private/neurotwin-messages
MEDIA_IMAGE_MB=8
MEDIA_VIDEO_MB=32
MEDIA_AUDIO_MB=12
MEDIA_DOCUMENT_MB=10
MEDIA_MESSAGE_MB=48
MEDIA_USER_QUOTA_MB=256
MEDIA_UPLOADS_PER_DAY=100
MEDIA_SCAN_EXECUTABLE=
MEDIA_ALLOW_UNSCANNED_DEVELOPMENT=true
MEDIA_PROCESS_TIMEOUT_SECONDS=60
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
