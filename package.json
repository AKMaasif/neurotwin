{
  "name": "neurotwin",
  "version": "0.1.0",
  "private": true,
  "description": "Browser checks and formatting for the NeuroTwin clients",
  "scripts": {
    "format": "prettier --write \"web/**/*.{js,css,html}\" \"scripts/*.cjs\"",
    "format:check": "prettier --check \"web/**/*.{js,css,html}\" \"scripts/*.cjs\"",
    "test:browser": "node scripts/browser_check.cjs",
    "test:documents": "node scripts/document_browser_check.cjs && node scripts/document_ui_checks.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "printWidth": 100
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
